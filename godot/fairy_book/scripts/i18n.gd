class_name I18n
## Локализация игры: русский (ru) и английский (en).
##
## Русская строка сама является ключом словаря, поэтому перевод вызывается
## прямо на месте: I18n.t("Задание: %s") % quest. Данные (главы, режимы,
## лавка, наряды) переводятся целиком через I18n.tree().

const SETTINGS := "user://settings.cfg"
const RU := "ru"
const EN := "en"

## языки для экрана выбора (название всегда пишется на своём языке)
const LANGS: Array[Dictionary] = [
	{"id": "ru", "title": "Русский", "sub": "Русский / Russian"},
	{"id": "en", "title": "English", "sub": "English / Английский"},
]

## текущий язык (по умолчанию русский, до выбора на первом запуске)
static var lang := RU


## перевод строки: %s, %d и прочие подстановки переводятся вместе с текстом
static func t(ru: String) -> String:
	if lang == RU:
		return ru
	return str(TEXT.get(ru, ru))


## перевод всех строк внутри данных (словари, массивы) — структура сохраняется
static func tree(v: Variant) -> Variant:
	if v is String:
		return t(v)
	if v is Array:
		var out := []
		out.resize(v.size())
		for i in v.size():
			out[i] = tree(v[i])
		return out
	if v is Dictionary:
		var d := {}
		for k in v.keys():
			d[k] = tree(v[k])
		return d
	return v


static func is_en() -> bool:
	return lang == EN


## название языка на его собственном языке
static func title_of(id: String) -> String:
	for d in LANGS:
		if d["id"] == id:
			return str(d["title"])
	return str(LANGS[0]["title"])


## сохранённый выбор ("", если язык ещё не выбирали)
static func saved() -> String:
	var cfg := ConfigFile.new()
	if cfg.load(SETTINGS) != OK:
		return ""
	var v := str(cfg.get_value("ui", "lang", ""))
	return v if v == RU or v == EN else ""


static func has_saved() -> bool:
	return saved() != ""


## сменить язык и запомнить выбор
static func set_lang(id: String) -> void:
	lang = id if id == EN else RU
	var cfg := ConfigFile.new()
	cfg.load(SETTINGS)
	cfg.set_value("ui", "lang", lang)
	cfg.save(SETTINGS)


## подхватить сохранённый язык при запуске
static func load_saved() -> void:
	var s := saved()
	if s != "":
		lang = s


